# Copia in .env per lo sviluppo locale, oppure imposta queste variabili su Railway (Variables).
# Database: su Railway si collega da solo aggiungendo Postgres (DATABASE_URL=${{Postgres.DATABASE_URL}}).
# In locale, senza DATABASE_URL, il server usa PGlite in ./data/pglite.
DATABASE_URL=
# Indirizzo pubblico del gioco (serve per i link di Google/Facebook e delle email). Su Railway si ricava da solo.
PUBLIC_URL=
# Accesso con Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Accesso con Facebook: https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Email per il recupero password: https://resend.com
RESEND_API_KEY=
MAIL_FROM=Racket King Online <noreply@tuodominio.it>
# Opzionale: data di apertura del server (ISO). Senza, il mondo parte al primo avvio.
WORLD_START=
